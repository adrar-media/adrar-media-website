# =============================================================================
# ADRAR MEDIA — SITE WEB / Variables d'environnement (modèle)
# -----------------------------------------------------------------------------
# Copier ce fichier vers .env.local et renseigner les valeurs RÉELLES.
# .env.local n'est JAMAIS committé (cf. .gitignore).
# Aucune valeur ici ne doit être un secret : ce fichier est versionné.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Domaine de production, utilisé pour canonical, sitemap et Open Graph.
NEXT_PUBLIC_SITE_URL=https://CONTENT_REQUIRED

# --- Contact (PROMPT §32 / §35 — ne jamais inventer ces valeurs) ---------------
# Format international sans espaces ni "+" pour le lien wa.me. Ex: 2126XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Format affiché à l'écran. Ex: +212 6 XX XX XX XX
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LOCATION=

# --- Réseaux sociaux (URLs complètes, vides tant que non confirmées) ----------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Analytics (PROMPT §49 — IDs configurables, jamais en dur) ---------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Formulaire de devis (PHASE 11) ------------------------------------------
# Clé serveur du service d'envoi d'email. JAMAIS de préfixe NEXT_PUBLIC_.
EMAIL_API_KEY=
QUOTE_NOTIFICATION_TO=
QUOTE_NOTIFICATION_FROM=

# --- Intégration future Adrar OS / CRM (PROMPT §22 — non implémentée) --------
# Laisser vide tant que les APIs Adrar OS ne sont pas définies.
ADRAR_OS_API_URL=
ADRAR_OS_API_KEY=
