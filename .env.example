# =============================================================================
# ADRAR MEDIA — SITE WEB / Variables d'environnement (modèle)
# -----------------------------------------------------------------------------
# Copier ce fichier vers .env.local et renseigner les valeurs RÉELLES.
# .env.local n'est JAMAIS committé (cf. .gitignore).
# Aucune valeur ici ne doit être un secret : ce fichier est versionné.
#
# Règle générale : une variable vide n'est pas une erreur. Le site est écrit
# pour masquer proprement ce qui n'est pas configuré — un canal de contact
# absent disparaît, il n'est jamais remplacé par une valeur inventée.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# OBLIGATOIRE en production. Sans lui : pas de sitemap, pas d'URL canonique
# absolue, pas d'image de partage résolue, pas de données structurées complètes.
# Sans barre oblique finale. Ex. : https://adrarmedia.ma
NEXT_PUBLIC_SITE_URL=

# --- Identité légale et hébergeur (obligatoire avant publication) ------------
# Renseigner uniquement les valeurs figurant sur les documents officiels de
# l'entreprise. Les pages légales restent explicitement incomplètes tant que
# l'un de ces champs manque ; aucune donnée n'est déduite du nom commercial.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_SHARE_CAPITAL=
NEXT_PUBLIC_TRADE_REGISTER=
NEXT_PUBLIC_TAX_ID=
NEXT_PUBLIC_ICE=
NEXT_PUBLIC_REGISTERED_OFFICE=
NEXT_PUBLIC_PUBLICATION_DIRECTOR=
# Adresse de contact pour l'exercice des droits liés aux données personnelles.
NEXT_PUBLIC_DATA_CONTACT_EMAIL=
# Numéro ou récépissé CNDP officiel applicable au traitement du site.
NEXT_PUBLIC_CNDP_RECEIPT=
# Coordonnées contractuelles de l'hébergeur retenu.
NEXT_PUBLIC_HOST_NAME=
NEXT_PUBLIC_HOST_ADDRESS=
NEXT_PUBLIC_HOST_URL=

# --- Contact (ne jamais inventer ces valeurs) ---------------------------------
# Les téléphones et adresses e-mail confirmés par la direction ont une valeur
# par défaut dans config/site.ts : le site reste joignable même sans .env.
# Ces variables servent à les ÉCRASER (changement de ligne, boîte de test).
#
# Format international sans espaces ni « + », pour le lien wa.me. Ex. : 2126XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Ligne mobile. Format affiché à l'écran. Ex. : 06 XX XX XX XX
NEXT_PUBLIC_PHONE_DISPLAY=
# Même numéro au format E.164, pour le lien tel:. Ex. : +2126XXXXXXXX
NEXT_PUBLIC_PHONE_E164=
# Ligne fixe du bureau, mêmes deux formats.
NEXT_PUBLIC_LANDLINE_DISPLAY=
NEXT_PUBLIC_LANDLINE_E164=
NEXT_PUBLIC_CONTACT_EMAIL=
# Boîte des candidatures, distincte de l'adresse commerciale.
NEXT_PUBLIC_RECRUITMENT_EMAIL=
# Adresse affichée dans le pied de page et sous la carte.
# Confirmée : N° 47, Lot Nakhil 6, Ahadaf, Azrou (repli dans config/site.ts).
NEXT_PUBLIC_LOCATION=
# Ville et pays, pour les données structurées (schema.org PostalAddress).
NEXT_PUBLIC_LOCALITY=
NEXT_PUBLIC_COUNTRY=
# Repère envoyé à Google Maps, si différent du libellé affiché. Ce sont des
# COORDONNÉES et non l'adresse écrite : « Lot Nakhil 6 » n'est pas une voie
# référencée, envoyée telle quelle elle place l'épingle au centre d'Azrou.
# Vide, la carte retombe sur NEXT_PUBLIC_LOCATION ; les deux vides, la carte
# de la page Contact ne s'affiche pas du tout.
NEXT_PUBLIC_MAP_QUERY=
# Mêmes coordonnées, séparées, pour le champ geo des données structurées.
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# --- Réseaux sociaux (URLs complètes, vides tant que non confirmées) ----------
# Alimentent la rangée d'icônes du pied de page et de la page Contact, ainsi
# que le champ sameAs des données structurées.
# Instagram et LinkedIn sont confirmés et ont un repli dans config/site.ts ;
# ces variables servent à les écraser. Facebook et TikTok restent vides tant
# qu'aucun compte n'est communiqué — leur icône n'apparaît alors pas.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Mesure d'audience -------------------------------------------------------
# Tant qu'aucun identifiant n'est renseigné, aucun script tiers n'est chargé et
# la bannière de consentement ne s'affiche pas : il n'y aurait rien à consentir.
# Dès qu'un identifiant est présent, les scripts n'entrent en jeu qu'après un
# accord explicite du visiteur.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Formulaires (devis + message du pied de page) ----------------------------
# LES DEUX FORMULAIRES DU SITE ABOUTISSENT TOUJOURS DANS LA MÊME BOÎTE :
# contact@adrar.media. Cette destination est fixée côté serveur et ne dépend
# d'aucune variable d'environnement. L'objet du message distingue les deux —
# « Demande de devis — … » et « Message du site — … ».
#
# DEUX VARIABLES SUFFISENT à activer l'envoi automatique : la clé et
# l'expéditeur. Si l'une manque, l'envoi est considéré comme non configuré et
# le formulaire propose au visiteur d'envoyer sa demande lui-même par e-mail ou
# WhatsApp. Rien n'est perdu, rien n'est faussement confirmé.
#
# Clé serveur du service d'envoi (Resend). JAMAIS de préfixe NEXT_PUBLIC_ :
# une clé exposée au navigateur peut être utilisée par n'importe qui.
EMAIL_API_KEY=
# Expéditeur technique. OBLIGATOIRE, et le domaine doit être VÉRIFIÉ chez
# Resend — sans quoi chaque envoi est refusé. C'est pour cette raison qu'il n'a
# pas de valeur par défaut : une valeur devinée transformerait un repli qui
# fonctionne en panne silencieuse.
# Ex. : Site Adrar Media <no-reply@adrar.media>
QUOTE_NOTIFICATION_FROM=
# --- Intégration Adrar OS / CRM (facultative) --------------------------------
# Point d'entrée qui recevra une copie des demandes de devis. Laisser vide tant
# qu'Adrar OS n'expose pas de modèle Lead : l'appel est alors simplement ignoré.
ADRAR_OS_API_URL=
ADRAR_OS_API_KEY=

# --- Guide de style interne --------------------------------------------------
# /{langue}/styleguide est fermé en production. Mettre « 1 » pour l'ouvrir
# temporairement, par exemple le temps d'une revue avec la direction artistique.
NEXT_PUBLIC_STYLEGUIDE=
# Animation de marque avant le premier écran. Désactivée par défaut pour le LCP.
NEXT_PUBLIC_ENABLE_PRELOADER=false
