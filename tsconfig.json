{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    /*
     * `scripts/generate-imagery.ts` est exécuté directement par Node
     * (retrait des types natif, ≥ 22.18), ce qui impose d'écrire
     * l'extension .ts dans ses imports. Sans cette option, tsc rejette
     * un fichier qui s'exécute pourtant sans étape de compilation.
     * Sans effet sur le bundle : `noEmit` est actif et Next résout ses
     * propres imports sans extension comme avant.
     */
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
